{
  "_note": "ILLUSTRATIVE demo vocabulary only. Codes are a tiny hand-picked subset of ICD-10-CM, RxNorm and LOINC; verify against the official releases before any real use. SNOMED CT is deliberately excluded (licensed).",

  "sectionHeaders": [
    { "name": "CHIEF_COMPLAINT",            "pattern": "^[ \\t]*(?:chief complaint|CC)[ \\t]*:", "priority": 0 },
    { "name": "HISTORY_OF_PRESENT_ILLNESS", "pattern": "^[ \\t]*(?:history of present illness|HPI)[ \\t]*:", "priority": 0 },
    { "name": "PAST_MEDICAL_HISTORY",       "pattern": "^[ \\t]*(?:past medical history|PMH)[ \\t]*:", "priority": 0 },
    { "name": "MEDICATIONS",                "pattern": "^[ \\t]*(?:current )?(?:medications|meds)[ \\t]*:", "priority": 0 },
    { "name": "ALLERGIES",                  "pattern": "^[ \\t]*allergies[ \\t]*:", "priority": 0 },
    { "name": "FAMILY_HISTORY",             "pattern": "^[ \\t]*(?:family history|FH)[ \\t]*:", "priority": 0, "experiencer": "FAMILY" },
    { "name": "SOCIAL_HISTORY",             "pattern": "^[ \\t]*(?:social history|SH)[ \\t]*:", "priority": 0 },
    { "name": "REVIEW_OF_SYSTEMS",          "pattern": "^[ \\t]*(?:review of systems|ROS)[ \\t]*:", "priority": 0 },
    { "name": "VITALS",                     "pattern": "^[ \\t]*vitals?(?: signs)?[ \\t]*:", "priority": 0 },
    { "name": "PHYSICAL_EXAM",              "pattern": "^[ \\t]*(?:physical exam(?:ination)?|PE)[ \\t]*:", "priority": 0 },
    { "name": "LABS",                       "pattern": "^[ \\t]*(?:labs?|laboratory(?: results| data)?)[ \\t]*:", "priority": 0 },
    { "name": "ASSESSMENT",                 "pattern": "^[ \\t]*(?:assessment(?: (?:and|&) plan)?|impression|A/P)[ \\t]*:", "priority": 0 },
    { "name": "PLAN",                       "pattern": "^[ \\t]*plan[ \\t]*:", "priority": 0 }
  ],

  "regexRules": [
    { "ruleName": "PHI_MRN",   "ruleGroup": "PHI", "category": "MRN",
      "pattern": "(?i)\\bMRN[ \\t]*[:#]?[ \\t]*[A-Z]{0,3}\\d{5,12}\\b", "description": "Medical record number" },
    { "ruleName": "PHI_SSN",   "ruleGroup": "PHI", "category": "SSN",
      "pattern": "(?<!\\d)\\d{3}-\\d{2}-\\d{4}(?!\\d)", "description": "US social security number" },
    { "ruleName": "PHI_PHONE", "ruleGroup": "PHI", "category": "PHONE",
      "pattern": "(?<![\\d-])(?:\\+?1[-. ]?)?\\(?\\d{3}\\)?[-. ]\\d{3}[-. ]\\d{4}(?!\\d)", "description": "US phone number" },
    { "ruleName": "PHI_EMAIL", "ruleGroup": "PHI", "category": "EMAIL",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b", "description": "E-mail address" },
    { "ruleName": "PHI_DOB",   "ruleGroup": "PHI", "category": "DOB",
      "pattern": "(?i)\\b(?:DOB|date of birth|birth date)[ \\t]*[:\\-]?[ \\t]*\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}\\b", "description": "Date of birth" },
    { "ruleName": "PHI_PATIENT_NAME", "ruleGroup": "PHI", "category": "NAME",
      "pattern": "(?i:patient(?: name)?)[ \\t]*:[ \\t]*[A-Z][a-z]+(?:[ \\t]+[A-Z][a-z]*\\.?){1,2}", "description": "Name following a 'Patient:' label (heuristic)" },

    { "ruleName": "MEAS_BLOOD_PRESSURE", "ruleGroup": "MEASUREMENT", "category": "BLOOD_PRESSURE", "valueGroup": 1, "unit": "mmHg",
      "pattern": "(?i)\\b(?:BP|blood pressure)[ \\t]*[:=]?[ \\t]*(\\d{2,3}[ \\t]*/[ \\t]*\\d{2,3})\\b" },
    { "ruleName": "MEAS_HEART_RATE", "ruleGroup": "MEASUREMENT", "category": "HEART_RATE", "valueGroup": 1, "unit": "bpm",
      "pattern": "(?i)\\b(?:HR|heart rate|pulse)[ \\t]*[:=]?[ \\t]*(\\d{2,3})\\b" },
    { "ruleName": "MEAS_RESP_RATE", "ruleGroup": "MEASUREMENT", "category": "RESPIRATORY_RATE", "valueGroup": 1, "unit": "/min",
      "pattern": "(?i)\\b(?:RR|resp(?:iratory)? rate)[ \\t]*[:=]?[ \\t]*(\\d{1,2})\\b" },
    { "ruleName": "MEAS_TEMPERATURE", "ruleGroup": "MEASUREMENT", "category": "TEMPERATURE", "valueGroup": 1,
      "pattern": "(?i)\\btemp(?:erature)?[ \\t]*[:=]?[ \\t]*(\\d{2,3}(?:\\.\\d)?)" },
    { "ruleName": "MEAS_SPO2", "ruleGroup": "MEASUREMENT", "category": "OXYGEN_SATURATION", "valueGroup": 1, "unit": "%",
      "pattern": "(?i)\\b(?:SpO2|O2 sat(?:uration)?|oxygen saturation)[ \\t]*[:=]?[ \\t]*(\\d{2,3})[ \\t]*%?" },
    { "ruleName": "MEAS_LAB_VALUE", "ruleGroup": "MEASUREMENT", "category": "LAB_VALUE", "valueGroup": 0,
      "pattern": "(?i)\\b(?:glucose|creatinine|hemoglobin a1c|hba1c|a1c|potassium|sodium|troponin(?: i)?|ldl|tsh)[ \\t]*[:=]?[ \\t]*\\d+(?:\\.\\d+)?[ \\t]*(?:mg/dL|mmol/L|mEq/L|ng/mL|mIU/L|%)?" },
    { "ruleName": "MEAS_DOSAGE", "ruleGroup": "MEASUREMENT", "category": "DOSAGE", "valueGroup": 0,
      "pattern": "(?i)\\b\\d+(?:\\.\\d+)?[ \\t]*(?:mg|mcg|g|ml|units?|iu)\\b(?!/)(?:[ \\t]*(?:po|iv|im|sq|sl)\\b)?(?:[ \\t]*(?:daily|bid|tid|qid|qd|qhs|prn|q\\d{1,2}h)\\b)?",
      "description": "Strength with optional route/frequency, e.g. 500 mg BID. Not matched when followed by '/' (mg/dL is a lab unit)." }
  ],

